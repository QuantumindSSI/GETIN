[Unit]
Description=GETIN Telegram Bot — DeFi Yield Scanner and Demo Quest Tracker
After=network.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/getin
EnvironmentFile=/home/azureuser/getin/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/azureuser/getin/venv/bin/python -u -m src.telegram_bot
Restart=always
RestartSec=10
StandardOutput=append:/home/azureuser/getin/logs/getin-bot.log
StandardError=append:/home/azureuser/getin/logs/getin-bot.log

[Install]
WantedBy=multi-user.target