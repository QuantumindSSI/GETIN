# Market data
CRYPTORANK_API_KEY=your_cryptorank_api_key_here

# Farming wallets (legacy — use wallet files instead)
PRIVATE_KEY=0x00
SOLANA_PRIVATE_KEY=0x00

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_OWNER_ID=your_telegram_user_id

# Exchange (Kraken) — required for fiat on-ramp
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret

# Twitter — from developer.twitter.com
# Use the "API Key and Secret" (OAuth 1.0a), NOT the OAuth 2.0 Client ID
TWITTER_CONSUMER_KEY=your_api_key
TWITTER_CONSUMER_SECRET=your_api_key_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_token_secret
TWITTER_BEARER_TOKEN=your_bearer_token

# Ethereum mainnet RPC (free public endpoint)
# For production, use your own Alchemy/QuickNode endpoint
ETH_RPC_URL=https://eth.drpc.org

# Solana mainnet RPC
SOL_RPC_URL=https://api.mainnet-beta.solana.com

# Safety / Limits
# Set DRY_RUN=false ONLY after verifying all wallet addresses and amounts
DRY_RUN=true
REQUIRE_CONFIRMATION=true
MAX_GAS_GWEI=50
MAX_PRIORITY_GWEI=2
MAX_SLIPPAGE_BPS=100
MIN_TRADE_ETH=0.001
MIN_TRADE_SOL=0.01
MAX_DAILY_ETH_SPEND=1.0
MAX_DAILY_SOL_SPEND=10.0